{
  "$schema": "file://home/at1ass/.config/quickshell/shell/config/config.schema.json",
  "version": 1,

  "appearance": {
    "theme": {
      "source": "wallpaper",
      "variant": "vibrant",
      "darkMode": true
    }
  },

  "bar": {
    "enabled": true,
    "position": "top",
    "height": 48,
    "margin": 16,
    "widgets": [
      {
        "type": "workspaces",
        "enabled": true,
        "section": "left",
        "monitors": "all",
        "settings": {
          "count": 9,
          "showWindows": true,
          "activeIndicator": "pill"
        }
      },
      {
        "type": "activewindow",
        "enabled": true,
        "section": "left",
        "monitors": "DP-1",
        "settings": {
          "maxWidth": 300,
          "showIcon": true
        }
      },
      {
        "type": "weather",
        "enabled": true,
        "section": "left",
        "clickAction": "dashboard-weather",
        "monitors": "DP-1",
        "settings": {
          "showIcon": true,
          "showTemp": true,
          "showLocation": false
        }
      },
      {
        "type": "clock",
        "enabled": true,
        "section": "center",
        "clickAction": "dashboard-quick",
        "settings": {
          "format": "HH:mm",
          "showDate": false
        }
      },
      {
        "type": "media",
        "enabled": true,
        "section": "right",
        "clickAction": "dashboard-quick",
        "monitors": "DP-1",
        "settings": {
          "compact": true,
          "showIcon": true,
          "maxWidth": 120
        }
      },
      {
        "type": "notifications",
        "enabled": true,
        "section": "right",
        "clickAction": "notification-center",
        "monitors": "DP-1",
        "settings": {
          "showCount": true
        }
      },
      {
        "type": "volume",
        "enabled": true,
        "section": "right",
        "clickAction": "dashboard-system",
        "settings": {
          "scrollable": true,
          "showPercentage": true
        }
      },
      {
        "type": "network",
        "enabled": false,
        "section": "right",
        "clickAction": "dashboard-quick",
        "settings": {
          "showIcon": true
        }
      },
      {
        "type": "battery",
        "enabled": false,
        "section": "right",
        "clickAction": "dashboard-quick",
        "settings": {
          "showPercentage": true,
          "showIcon": true
        }
      },
      {
        "type": "layout",
        "enabled": true,
        "section": "right"
      },
      {
        "type": "tray",
        "enabled": true,
        "section": "right",
        "settings": {
          "iconSize": 20,
          "spacing": 8
        }
      }
    ]
  },

  "dashboard": {
    "enabled": true,
    "width": 900,
    "height": 640
  },

  "notifications": {
    "historyTTLDays": 30,
    "panel": {
      "width": 400,
      "groupByApp": true
    },
    "popup": {
      "position": "top-right",
      "width": 360,
      "timeout": 7000,
      "maxVisible": 5
    }
  },

  "launcher": {
    "maxResults": 10,
    "width": 600,
    "listMaxHeight": 400,
    "topMargin": 56,
    "providers": [
      "applications",
      "calculator",
      "clipboard"
    ],
    "hiddenApps": []
  },

  "osd": {
    "enabled": true,
    "timeout": 2000
  },

  "lockscreen": {
    "enabled": false,
    "blurWallpaper": true,
    "showClock": true
  },

  "powerMenu": {
    "enabled": true,
    "confirmActions": true,
    "actions": ["lock", "suspend", "reboot", "shutdown", "logout"]
  },

  "gamingMode": {
    "disableAnimations": true,
    "disableWeather": true,
    "disableWallpaperChange": true,
    "hyprland": {
      "disableAnimations": true,
      "disableBlur": true,
      "disableShadows": true,
      "gaps": 0,
      "rounding": 0
    }
  },

  "wallpaper": {
    "primaryMonitor": "DP-1",
    "defaultWallpaper": "/home/at1ass/wallpapers/Anime Girl Sky Sunset 4k Wallpaper iPhone HD Phone 3201m.jpg",
    "postSetScript": "",
    "global": {
      "directory": "",
      "randomOrder": true,
      "autoChange": {
        "enabled": true,
        "intervalMs": 900000
      }
    },
    "monitors": {
      "DP-2": {
        "directory": "/home/at1ass/wallpapers/1080x1920",
        "fillMode": 2
      },
      "DP-1": {
        "directory": "/home/at1ass/wallpapers/3440x1440",
        "fillMode": 2
      }
    }
  },

  "services": {
    "weather": {
      "enabled": true,
      "location": "Penza",
      "latitude": 53.2,
      "longitude": 45.0,
      "units": "metric",
      "refreshMinutes": 15
    },
    "calendar": {
      "reminders": {
        "enabled": true,
        "minutesBefore": 15
      }
    },
    "vpn": {
      "enabled": false,
      "name": "nikuznetsov"
    }
  },

  "hyprland": {
    "workspaceCount": 10
  }
}
