{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "quickshell-shell-config",
  "title": "Quickshell Shell Configuration",
  "description": "Configuration schema for the Quickshell Hyprland shell. Place config at ~/.config/quickshell/config.json. Hot-reload is supported — changes apply immediately.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version"],

  "properties": {
    "$schema": {
      "type": "string",
      "description": "JSON Schema URI for editor validation."
    },

    "version": {
      "type": "integer",
      "const": 1,
      "description": "Config schema version. Must be 1."
    },

    "appearance": {
      "type": "object",
      "description": "Visual theme settings.",
      "additionalProperties": false,
      "properties": {
        "theme": {
          "type": "object",
          "description": "Material You color scheme generation.",
          "additionalProperties": false,
          "properties": {
            "source": {
              "type": "string",
              "enum": ["wallpaper", "custom"],
              "default": "wallpaper",
              "description": "'wallpaper' — generate palette from the current wallpaper. 'custom' — use a fixed seed color (reserved, not yet implemented)."
            },
            "variant": {
              "type": "string",
              "enum": ["tonalspot", "vibrant", "expressive", "fidelity", "neutral", "monochrome"],
              "default": "tonalspot",
              "description": "Material color scheme variant. Controls saturation of the generated palette. 'vibrant' and 'tonalspot' are most commonly used."
            },
            "darkMode": {
              "type": "boolean",
              "default": true,
              "description": "Dark (true) or light (false) color scheme."
            }
          }
        },
        "fontScale": {
          "type": "number",
          "default": 1.0,
          "minimum": 0.5,
          "maximum": 2.0,
          "description": "Global font size multiplier applied to all Material typography tokens. 1.0 = default M3 sizes, 0.8 = 80%, 1.2 = 120%. Supports hot-reload."
        }
      }
    },

    "bar": {
      "type": "object",
      "description": "Top status bar.",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show the status bar."
        },
        "position": {
          "type": "string",
          "enum": ["top"],
          "default": "top",
          "description": "Bar position. Currently only 'top' is supported."
        },
        "height": {
          "type": "integer",
          "default": 48,
          "minimum": 16,
          "maximum": 200,
          "description": "Bar height in logical pixels."
        },
        "margin": {
          "type": "integer",
          "default": 16,
          "minimum": 0,
          "maximum": 100,
          "description": "Gap between bar and screen edge in logical pixels."
        },
        "transparent": {
          "type": "boolean",
          "default": false,
          "description": "Fully transparent bar background. When true, the surface container and primary tint layers are hidden, showing only the widgets floating over the desktop."
        },
        "widgets": {
          "type": "array",
          "description": "Ordered list of bar widgets. Rendered left-to-right within each section.",
          "items": { "$ref": "#/definitions/barWidget" }
        }
      }
    },

    "dock": {
      "type": "object",
      "description": "Application dock at the bottom of the screen. Shows pinned and running applications with auto-hide support.",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false,
          "description": "Enable the application dock."
        },
        "autoHide": {
          "type": "boolean",
          "default": true,
          "description": "Auto-hide the dock. When true, dock is only visible when hovering the bottom screen edge."
        },
        "exclusive": {
          "type": "boolean",
          "default": false,
          "description": "Reserve screen space for the dock (exclusive zone). When false, windows can overlap the dock area."
        },
        "iconSize": {
          "type": "integer",
          "default": 48,
          "minimum": 24,
          "maximum": 96,
          "description": "Application icon size in logical pixels."
        },
        "pinnedApps": {
          "type": "array",
          "default": [],
          "description": "List of pinned application IDs (window class names). These always appear in the dock, in order.",
          "items": { "type": "string" }
        }
      }
    },

    "feed": {
      "type": "object",
      "description": "RSS/Atom feed reader panel. Opens as a right-side overlay with Google Discover-style article cards. Fetches on panel open, caches between sessions.",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false,
          "description": "Enable the feed panel feature."
        },
        "panelWidth": {
          "type": "integer",
          "default": 520,
          "minimum": 300,
          "maximum": 800,
          "description": "Feed panel width in logical pixels."
        },
        "refreshMinutes": {
          "type": "integer",
          "default": 30,
          "minimum": 5,
          "maximum": 1440,
          "description": "Minimum interval between feed refreshes (minutes). Feeds are only fetched when the panel is opened and the cache is older than this value."
        },
        "maxArticles": {
          "type": "integer",
          "default": 100,
          "minimum": 10,
          "maximum": 500,
          "description": "Maximum number of articles to keep in cache across all feeds."
        },
        "feeds": {
          "type": "array",
          "default": [],
          "description": "List of RSS/Atom feed sources.",
          "items": {
            "type": "object",
            "required": ["url"],
            "additionalProperties": false,
            "properties": {
              "url": {
                "type": "string",
                "format": "uri",
                "description": "RSS or Atom feed URL."
              },
              "name": {
                "type": "string",
                "description": "Display name for the feed source. If omitted, the domain name is used."
              },
              "category": {
                "type": "string",
                "description": "Category for grouping. Used as filter chip labels in the panel."
              }
            }
          }
        }
      }
    },

    "dashboard": {
      "type": "object",
      "description": "Dashboard panel (5-tab control center: Quick, Weather, Calendar, Audio, Network). Toggle via hotkey or by clicking bar widgets.",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable the dashboard."
        },
        "width": {
          "type": "integer",
          "default": 900,
          "minimum": 200,
          "description": "Dashboard panel width in logical pixels."
        },
        "height": {
          "type": "integer",
          "default": 640,
          "minimum": 200,
          "description": "Dashboard panel height in logical pixels."
        }
      }
    },

    "notifications": {
      "type": "object",
      "description": "Notification center and popup settings.",
      "additionalProperties": false,
      "properties": {
        "historyTTLDays": {
          "type": "integer",
          "default": 30,
          "minimum": 0,
          "description": "Auto-delete notification history older than this many days. 0 = disable pruning."
        },
        "panel": {
          "type": "object",
          "description": "Notification center sidebar (bell icon or IPC).",
          "additionalProperties": false,
          "properties": {
            "width": {
              "type": "integer",
              "default": 400,
              "minimum": 100,
              "description": "Notification center panel width in pixels."
            },
            "groupByApp": {
              "type": "boolean",
              "default": true,
              "description": "Group notifications by application."
            }
          }
        },
        "popup": {
          "type": "object",
          "description": "Transient notification popups.",
          "additionalProperties": false,
          "properties": {
            "width": {
              "type": "integer",
              "default": 360,
              "minimum": 100,
              "description": "Popup notification width in pixels."
            },
            "position": {
              "type": "string",
              "enum": ["top-right", "top-left", "bottom-right", "bottom-left"],
              "default": "top-right",
              "description": "Screen corner where popups appear."
            },
            "timeout": {
              "type": "integer",
              "default": 7000,
              "minimum": 0,
              "description": "Default auto-dismiss timeout in ms (fallback when urgency-specific timeout does not apply)."
            },
            "timeoutLow": {
              "type": "integer",
              "default": 3000,
              "minimum": 0,
              "description": "Auto-dismiss timeout for low-urgency notifications (ms)."
            },
            "timeoutNormal": {
              "type": "integer",
              "default": 7000,
              "minimum": 0,
              "description": "Auto-dismiss timeout for normal-urgency notifications (ms)."
            },
            "timeoutCritical": {
              "type": "integer",
              "default": 15000,
              "minimum": 0,
              "description": "Auto-dismiss timeout for critical notifications (ms). 0 = never auto-dismiss."
            },
            "maxVisible": {
              "type": "integer",
              "default": 5,
              "minimum": 1,
              "maximum": 20,
              "description": "Maximum simultaneous notification popups."
            }
          }
        }
      }
    },

    "launcher": {
      "type": "object",
      "description": "Application launcher with fuzzy search, calculator, and clipboard history.",
      "additionalProperties": false,
      "properties": {
        "maxResults": {
          "type": "integer",
          "default": 10,
          "minimum": 1,
          "maximum": 50,
          "description": "Maximum number of results shown."
        },
        "width": {
          "type": "integer",
          "default": 600,
          "minimum": 200,
          "description": "Launcher popup width in pixels."
        },
        "listMaxHeight": {
          "type": "integer",
          "default": 400,
          "minimum": 100,
          "description": "Maximum results list height before scrolling (pixels)."
        },
        "topMargin": {
          "type": "integer",
          "default": 56,
          "minimum": 0,
          "description": "Distance from top of screen to the launcher (pixels)."
        },
        "providers": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["applications", "calculator", "clipboard"]
          },
          "default": ["applications", "calculator", "clipboard"],
          "description": "'applications' — installed apps. 'calculator' — inline math (requires libqalculate). 'clipboard' — clipboard history (requires cliphist). Prefix '>' activates clipboard mode."
        },
        "hiddenApps": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string" },
          "default": [],
          "description": "Desktop file IDs to hide, e.g. ['org.kde.dolphin.desktop']."
        }
      }
    },

    "osd": {
      "type": "object",
      "description": "On-screen display overlays for volume/brightness changes.",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable OSD overlays."
        },
        "timeout": {
          "type": "integer",
          "default": 2000,
          "minimum": 500,
          "description": "Auto-hide delay in ms after the last change."
        }
      }
    },

    "lockscreen": {
      "type": "object",
      "description": "WlSessionLock-based lockscreen. Activated via IPC lockScreen() or loginctl lock-session.",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false,
          "description": "Enable the built-in lockscreen. When false, lock actions still work if an external locker intercepts the session lock signal."
        },
        "blurWallpaper": {
          "type": "boolean",
          "default": true,
          "description": "Apply blur to the wallpaper behind the lock UI."
        },
        "showClock": {
          "type": "boolean",
          "default": true,
          "description": "Show a large clock and date on the lockscreen."
        }
      }
    },

    "powerMenu": {
      "type": "object",
      "description": "Full-screen power actions overlay.",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable the power menu feature."
        },
        "confirmActions": {
          "type": "boolean",
          "default": true,
          "description": "Require a second click/Enter to confirm destructive actions (reboot, shutdown, logout)."
        },
        "actions": {
          "type": "array",
          "uniqueItems": true,
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": ["lock", "suspend", "reboot", "shutdown", "logout"]
          },
          "default": ["lock", "suspend", "reboot", "shutdown", "logout"],
          "description": "Actions to show. Order is preserved in the UI."
        }
      }
    },

    "gamingMode": {
      "type": "object",
      "description": "Gaming mode disables visual effects for performance. State persists across restarts — Hyprland settings are saved before and restored after.",
      "additionalProperties": false,
      "properties": {
        "disableAnimations": {
          "type": "boolean",
          "default": true,
          "description": "Disable shell animations (Tokens.durationScale = 0)."
        },
        "disableWeather": {
          "type": "boolean",
          "default": true,
          "description": "Pause weather API refreshes."
        },
        "disableWallpaperChange": {
          "type": "boolean",
          "default": true,
          "description": "Pause wallpaper auto-cycling."
        },
        "hyprland": {
          "type": "object",
          "description": "Hyprland compositor overrides via hyprctl. Previous values are saved and restored on disable.",
          "additionalProperties": false,
          "properties": {
            "disableAnimations": {
              "type": "boolean",
              "default": true,
              "description": "Set animations:enabled false."
            },
            "disableBlur": {
              "type": "boolean",
              "default": true,
              "description": "Set decoration:blur:enabled false."
            },
            "disableShadows": {
              "type": "boolean",
              "default": true,
              "description": "Set decoration:shadow:enabled false."
            },
            "gaps": {
              "type": "integer",
              "default": 0,
              "minimum": -1,
              "description": "Override general:gaps_in and general:gaps_out. -1 = leave unchanged."
            },
            "rounding": {
              "type": "integer",
              "default": 0,
              "minimum": -1,
              "description": "Override decoration:rounding. -1 = leave unchanged."
            }
          }
        }
      }
    },

    "wallpaper": {
      "type": "object",
      "description": "Multi-monitor wallpaper management via swww.",
      "additionalProperties": false,
      "properties": {
        "primaryMonitor": {
          "type": "string",
          "default": "",
          "description": "Monitor name (e.g. 'DP-1') whose wallpaper seeds the Material You palette. Empty = first monitor."
        },
        "defaultWallpaper": {
          "type": "string",
          "default": "",
          "description": "Fallback wallpaper path when no per-monitor path is configured."
        },
        "postSetScript": {
          "type": "string",
          "default": "",
          "description": "Shell command run after each wallpaper change. $WALLPAPER_PATH contains the new path."
        },
        "sources": {
          "type": "array",
          "default": [],
          "description": "Pluggable wallpaper sources. Currently supported types: 'local' (filesystem directory). Each monitor binds to one source by id.",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": ["id", "type"],
            "properties": {
              "id": {
                "type": "string",
                "description": "Unique source identifier referenced by monitors[].sourceId."
              },
              "type": {
                "type": "string",
                "enum": ["local"],
                "description": "Source type. 'local' = filesystem directory."
              },
              "name": {
                "type": "string",
                "description": "Human-readable label (used by picker UI; falls back to id)."
              },
              "path": {
                "type": "string",
                "description": "For type=local: directory path to scan for image files."
              }
            }
          }
        },
        "monitors": {
          "type": "object",
          "default": {},
          "description": "Per-monitor wallpaper bindings. Keys are monitor names (e.g. 'DP-1').",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "sourceId": {
                "type": "string",
                "description": "Source id from wallpaper.sources[]. Empty = use defaultWallpaper only."
              },
              "fillMode": {
                "type": "integer",
                "minimum": 0,
                "maximum": 6,
                "default": 2,
                "description": "Qt Image.FillMode: 0=Stretch, 1=PreserveAspectFit, 2=PreserveAspectCrop, 3=Tile, 4=TileVertically, 5=TileHorizontally, 6=Pad."
              },
              "randomOrder": {
                "type": "boolean",
                "default": true,
                "description": "Cycle in random order. false = alphabetical (for local sources)."
              },
              "autoChange": {
                "type": "object",
                "description": "Per-monitor auto-cycling.",
                "additionalProperties": false,
                "properties": {
                  "enabled": {
                    "type": "boolean",
                    "default": false,
                    "description": "Automatically cycle wallpapers on a timer for this monitor."
                  },
                  "intervalMs": {
                    "type": "integer",
                    "default": 300000,
                    "minimum": 10000,
                    "description": "Cycle interval in ms. Default 300000 (5 minutes). Minimum 10000 (10 seconds)."
                  }
                }
              }
            }
          }
        }
      }
    },

    "services": {
      "type": "object",
      "description": "External service integrations.",
      "additionalProperties": false,
      "properties": {
        "weather": {
          "type": "object",
          "description": "Weather data via Open-Meteo API (no API key required).",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true,
              "description": "Enable weather fetching and widgets."
            },
            "location": {
              "type": "string",
              "default": "London",
              "minLength": 1,
              "description": "Display name shown in weather widgets."
            },
            "latitude": {
              "type": "number",
              "default": 51.5,
              "minimum": -90,
              "maximum": 90,
              "description": "Latitude for weather API requests."
            },
            "longitude": {
              "type": "number",
              "default": -0.12,
              "minimum": -180,
              "maximum": 180,
              "description": "Longitude for weather API requests."
            },
            "units": {
              "type": "string",
              "enum": ["metric", "imperial"],
              "default": "metric",
              "description": "'metric' = celsius, km/h. 'imperial' = fahrenheit, mph."
            },
            "refreshMinutes": {
              "type": "integer",
              "default": 15,
              "minimum": 1,
              "maximum": 1440,
              "description": "Weather refresh interval in minutes."
            }
          }
        },
        "calendar": {
          "type": "object",
          "description": "Calendar integration via khal CLI with optional CalDAV sync (vdirsyncer).",
          "additionalProperties": false,
          "properties": {
            "reminders": {
              "type": "object",
              "description": "Desktop notification reminders for upcoming events.",
              "additionalProperties": false,
              "properties": {
                "enabled": {
                  "type": "boolean",
                  "default": true,
                  "description": "Send notify-send notification before calendar events."
                },
                "minutesBefore": {
                  "type": "integer",
                  "default": 15,
                  "minimum": 1,
                  "maximum": 1440,
                  "description": "Minutes before an event to trigger the reminder."
                },
                "lookaheadDays": {
                  "type": "integer",
                  "default": 2,
                  "minimum": 1,
                  "maximum": 30,
                  "description": "How many days ahead the reminder engine pre-loads events. Increase if you want reminders for events further out."
                }
              }
            },
            "dayView": {
              "type": "object",
              "description": "Timeline day view in the Calendar tab.",
              "additionalProperties": false,
              "properties": {
                "hourHeight": {
                  "type": "integer",
                  "default": 60,
                  "minimum": 30,
                  "maximum": 120,
                  "description": "Height of one hour slot in the timeline view (pixels)."
                }
              }
            },
            "firstDayOfWeek": {
              "type": "integer",
              "default": 1,
              "minimum": 0,
              "maximum": 6,
              "description": "First day of the week column. 0=Sunday, 1=Monday, ..., 6=Saturday."
            }
          }
        },
        "vpn": {
          "type": "object",
          "description": "VPN status via NetworkManager.",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false,
              "description": "Enable VPN status tracking and quick-toggle."
            },
            "name": {
              "type": "string",
              "default": "",
              "description": "NetworkManager VPN connection name to monitor and toggle."
            }
          }
        },
        "nightLight": {
          "type": "object",
          "description": "Night light (color temperature) via hyprsunset.",
          "additionalProperties": false,
          "properties": {
            "temperature": {
              "type": "integer",
              "default": 4500,
              "minimum": 1000,
              "maximum": 6500,
              "description": "Color temperature in Kelvin. Lower = warmer (more orange). Default 6500K = no change."
            }
          }
        }
      }
    },

    "hyprland": {
      "type": "object",
      "description": "Hyprland compositor settings.",
      "additionalProperties": false,
      "properties": {
        "workspaceCount": {
          "type": "integer",
          "default": 10,
          "minimum": 1,
          "maximum": 100,
          "description": "Number of workspaces shown in the bar widget."
        }
      }
    }
  },

  "definitions": {
    "monitorFilter": {
      "description": "'all' for every monitor, a single monitor name, or an array of monitor names.",
      "oneOf": [
        { "type": "string" },
        { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 }
      ],
      "default": "all"
    },

    "clickAction": {
      "type": "string",
      "enum": [
        "dashboard-quick",
        "dashboard-weather",
        "dashboard-calendar",
        "dashboard-system",
        "dashboard-audio",
        "dashboard-network",
        "notification-center",
        "launcher",
        "control-panel",
        "feed-panel"
      ],
      "description": "Panel to open when the widget is left-clicked."
    },

    "barWidget": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": ["workspaces", "activewindow", "weather", "clock", "media", "notifications", "volume", "network", "battery", "layout", "tray", "feed"],
          "description": "Widget type identifier."
        },
        "enabled": {
          "type": "boolean",
          "default": true,
          "description": "Whether this widget instance is active."
        },
        "section": {
          "type": "string",
          "enum": ["left", "center", "right"],
          "default": "left",
          "description": "Bar section where this widget appears."
        },
        "monitors": { "$ref": "#/definitions/monitorFilter" },
        "clickAction": { "$ref": "#/definitions/clickAction" },
        "settings": {
          "type": "object",
          "description": "Widget-specific settings (validated per widget type)."
        }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "workspaces" } }, "required": ["type"] },
          "then": { "properties": { "settings": { "$ref": "#/definitions/workspacesSettings" } } }
        },
        {
          "if": { "properties": { "type": { "const": "activewindow" } }, "required": ["type"] },
          "then": { "properties": { "settings": { "$ref": "#/definitions/activewindowSettings" } } }
        },
        {
          "if": { "properties": { "type": { "const": "weather" } }, "required": ["type"] },
          "then": { "properties": { "settings": { "$ref": "#/definitions/weatherWidgetSettings" } } }
        },
        {
          "if": { "properties": { "type": { "const": "clock" } }, "required": ["type"] },
          "then": { "properties": { "settings": { "$ref": "#/definitions/clockSettings" } } }
        },
        {
          "if": { "properties": { "type": { "const": "media" } }, "required": ["type"] },
          "then": { "properties": { "settings": { "$ref": "#/definitions/mediaSettings" } } }
        },
        {
          "if": { "properties": { "type": { "const": "notifications" } }, "required": ["type"] },
          "then": { "properties": { "settings": { "$ref": "#/definitions/notificationsWidgetSettings" } } }
        },
        {
          "if": { "properties": { "type": { "const": "volume" } }, "required": ["type"] },
          "then": { "properties": { "settings": { "$ref": "#/definitions/volumeSettings" } } }
        },
        {
          "if": { "properties": { "type": { "const": "network" } }, "required": ["type"] },
          "then": { "properties": { "settings": { "$ref": "#/definitions/networkSettings" } } }
        },
        {
          "if": { "properties": { "type": { "const": "battery" } }, "required": ["type"] },
          "then": { "properties": { "settings": { "$ref": "#/definitions/batterySettings" } } }
        },
        {
          "if": { "properties": { "type": { "const": "layout" } }, "required": ["type"] },
          "then": { "properties": { "settings": { "$ref": "#/definitions/emptySettings" } } }
        },
        {
          "if": { "properties": { "type": { "const": "tray" } }, "required": ["type"] },
          "then": { "properties": { "settings": { "$ref": "#/definitions/traySettings" } } }
        },
        {
          "if": { "properties": { "type": { "const": "feed" } }, "required": ["type"] },
          "then": { "properties": { "settings": { "$ref": "#/definitions/emptySettings" } } }
        }
      ]
    },

