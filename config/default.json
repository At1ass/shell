{
  "version": 1,

  "appearance": {
    "theme": {
      "source": "wallpaper",
      "variant": "vibrant",
      "darkMode": true
    },
    "fontScale": 1.0
  },

  "bar": {
    "enabled": true,
    "position": "top",
    "height": 48,
    "margin": 16,
    "transparent": false,
    "widgets": [
      {
        "type": "workspaces",
        "enabled": true,
        "section": "left",
        "monitors": "all",
        "settings": {
          "count": 10,
          "showWindows": true,
          "activeIndicator": "pill"
        }
      },
      {
        "type": "activewindow",
        "enabled": true,
        "section": "left",
        "monitors": "all",
        "settings": {
          "maxWidth": 300,
          "showIcon": true
        }
      },
      {
        "type": "weather",
        "enabled": true,
        "section": "left",
        "clickAction": "dashboard-weather",
        "monitors": "all",
        "settings": {
          "showIcon": true,
          "showTemp": true,
          "showLocation": false
        }
      },
      {
        "type": "clock",
        "enabled": true,
        "section": "center",
        "clickAction": "dashboard-quick",
        "settings": {
          "format": "HH:mm",
          "showDate": false
        }
      },
      {
        "type": "media",
        "enabled": true,
        "section": "right",
        "clickAction": "dashboard-quick",
        "settings": {
          "compact": true,
          "showIcon": true,
          "maxWidth": 120
        }
      },
      {
        "type": "notifications",
        "enabled": true,
        "section": "right",
        "clickAction": "notification-center",
        "settings": {
          "showCount": true
        }
      },
      {
        "type": "volume",
        "enabled": true,
        "section": "right",
        "clickAction": "dashboard-system",
        "settings": {
          "scrollable": true,
          "showPercentage": true
        }
      },
      {
        "type": "network",
        "enabled": false,
        "section": "right",
        "clickAction": "dashboard-quick",
        "settings": {
          "showIcon": true
        }
      },
      {
        "type": "battery",
        "enabled": false,
        "section": "right",
        "clickAction": "dashboard-quick",
        "settings": {
          "showPercentage": true,
          "showIcon": true
        }
      },
      {
        "type": "layout",
        "enabled": true,
        "section": "right"
      },
      {
        "type": "tray",
        "enabled": true,
        "section": "right",
        "settings": {
          "iconSize": 20,
          "spacing": 8
        }
      }
    ]
  },

  "dock": {
    "enabled": false,
    "autoHide": true,
    "exclusive": false,
    "iconSize": 48,
    "pinnedApps": []
  },

  "dashboard": {
    "enabled": true,
    "width": 900,
    "height": 640
  },

  "notifications": {
    "historyTTLDays": 30,
    "panel": {
      "width": 400,
      "groupByApp": true
    },
    "popup": {
      "width": 360,
      "position": "top-right",
      "timeout": 7000,
      "timeoutLow": 3000,
      "timeoutNormal": 7000,
      "timeoutCritical": 15000,
      "maxVisible": 5
    }
  },

  "launcher": {
    "maxResults": 10,
    "width": 600,
    "listMaxHeight": 400,
    "topMargin": 56,
    "providers": ["applications", "calculator", "clipboard"],
    "hiddenApps": []
  },

  "osd": {
    "enabled": true,
    "timeout": 2000
  },

  "lockscreen": {
    "enabled": false,
    "blurWallpaper": true,
    "showClock": true
  },

  "powerMenu": {
    "confirmActions": true,
    "actions": ["lock", "suspend", "reboot", "shutdown", "logout"]
  },

  "gamingMode": {
    "disableAnimations": true,
    "disableWeather": true,
    "disableWallpaperChange": true,
    "hyprland": {
      "disableAnimations": true,
      "disableBlur": true,
      "disableShadows": true,
      "gaps": 0,
      "rounding": 0
    }
  },

  "wallpaper": {
    "primaryMonitor": "",
    "defaultWallpaper": "",
    "postSetScript": "",
    "global": {
      "directory": "",
      "randomOrder": true,
      "autoChange": {
        "enabled": false,
        "intervalMs": 300000
      }
    },
    "monitors": {}
  },

  "services": {
    "weather": {
      "enabled": true,
      "location": "London",
      "latitude": 51.5,
      "longitude": -0.12,
      "units": "metric",
      "refreshMinutes": 15
    },
    "calendar": {
      "reminders": {
        "enabled": true,
        "minutesBefore": 15
      },
      "upcoming": {
        "count": 4,
        "days": 7
      },
      "dayView": {
        "hourHeight": 60
      }
    },
    "vpn": {
      "enabled": false,
      "name": ""
    },
    "nightLight": {
      "temperature": 4500
    }
  },

  "hyprland": {
    "workspaceCount": 10
  }
}
