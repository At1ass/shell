{
  "version": 1,
  "appearance": {
    "theme": {
      "source": "wallpaper",
      "variant": "tonalspot",
      "contrast": 0.0,
      "darkMode": true
    },
    "designSystem": "md3",
    "fontScale": 1.3,
    "fontFamily": "",
    "monoFamily": "",
    "panelOpacity": 1.0,
    "reduceMotion": false,
    "motionScale": 1.0
  },
  "performance": {
    "keepPanelsLoaded": [
      "launcher",
      "dashboard",
      "notificationCenter",
      "cheatsheet"
    ]
  },
  "modules": {
    "bar": true,
    "dock": false,
    "wallpaper": true,
    "dashboard": true,
    "launcher": true,
    "notifications": true,
    "osd": true,
    "lockscreen": false,
    "powerMenu": true,
    "cheatsheet": true,
    "screenshot": true,
    "toasts": true,
    "popouts": true,
    "polkit": false,
    "recorder": true,
    "connections": true,
    "audio": true
  },
  "bar": {
    "position": "top",
    "height": 48,
    "margin": 16,
    "transparent": false,
    "autoHide": false,
    "widgets": [
      {
        "type": "workspaces",
        "enabled": true,
        "section": "left",
        "monitors": "all",
        "settings": {
          "count": 10,
          "showWindows": true,
          "maxWindowsPerWorkspace": 4,
          "activeIndicator": "pill"
        },
        "priority": null
      },
      {
        "type": "activewindow",
        "enabled": true,
        "section": "left",
        "monitors": "all",
        "settings": {
          "maxWidth": 300,
          "showIcon": true
        },
        "priority": null
      },
      {
        "type": "weather",
        "enabled": true,
        "section": "left",
        "clickAction": "dashboard-weather",
        "monitors": "all",
        "settings": {
          "showIcon": true,
          "showTemp": true,
          "showLocation": false
        },
        "priority": null
      },
      {
        "type": "clock",
        "enabled": true,
        "section": "center",
        "clickAction": "dashboard-calendar",
        "settings": {
          "format": "HH:mm",
          "showDate": false
        },
        "priority": null
      },
      {
        "type": "media",
        "enabled": true,
        "section": "right",
        "clickAction": "dashboard-quick",
        "settings": {
          "compact": true,
          "showIcon": true,
          "maxWidth": 120
        },
        "priority": null
      },
      {
        "type": "notifications",
        "enabled": true,
        "section": "right",
        "clickAction": "notification-center",
        "settings": {
          "showCount": true
        },
        "priority": null
      },
      {
        "type": "volume",
        "enabled": true,
        "section": "right",
        "clickAction": "audio",
        "settings": {
          "scrollable": true,
          "showPercentage": true
        },
        "priority": null
      },
      {
        "type": "network",
        "enabled": false,
        "section": "right",
        "clickAction": "connections-wifi",
        "settings": {
          "showIcon": true,
          "showLabel": false
        },
        "priority": null
      },
      {
        "type": "battery",
        "enabled": false,
        "section": "right",
        "clickAction": "dashboard-quick",
        "settings": {
          "showPercentage": true,
          "showIcon": true
        },
        "priority": null
      },
      {
        "type": "layout",
        "enabled": true,
        "section": "right",
        "priority": null
      },
      {
        "type": "tray",
        "enabled": true,
        "section": "right",
        "settings": {
          "iconSize": 20,
          "spacing": 8,
          "maxVisible": 4,
          "pinnedIds": []
        },
        "priority": null
      }
    ]
  },
  "dock": {
    "position": "bottom",
    "autoHide": true,
    "exclusive": false,
    "iconSize": 48,
    "pinnedApps": []
  },
  "dashboard": {
    "width": 900,
    "height": 640
  },
  "notifications": {
    "historyTTLDays": 30,
    "panel": {
      "width": 400,
      "groupByApp": true,
      "clearUndoTimeout": 8000
    },
    "popup": {
      "width": 360,
      "position": "top-right",
      "monitor": "focused",
      "timeout": 7000,
      "timeoutLow": 3000,
      "timeoutNormal": 7000,
      "timeoutCritical": 15000,
      "maxVisible": 5,
      "margin": 16
    },
    "maxHistory": 200,
    "dnd": {
      "suppressOnFullscreen": true
    },
    "rateLimit": {
      "ingressPerSecond": 20,
      "maxQueue": 32,
      "popupIntervalMs": 350,
      "maxPopupQueue": 8
    },
    "filters": {
      "noPopup": [],
      "noHistory": []
    }
  },
  "launcher": {
    "maxResults": 10,
    "width": 600,
    "listMaxHeight": 400,
    "topMargin": 56,
    "hiddenApps": []
  },
  "osd": {
    "monitorPolicy": "focused",
    "timeout": 2000
  },
  "recorder": {
    "socket": "",
    "output": {
      "directory": "",
      "container": "mkv"
    },
    "capture": {
      "target": "portal",
      "restorePortalSession": true,
      "cursor": true
    },
    "video": {
      "fps": 60,
      "codec": "av1",
      "quality": "very_high",
      "framerateMode": "vfr"
    },
    "audio": {
      "sources": [
        "default_output"
      ]
    },
    "indicator": {
      "position": "topRight",
      "margin": 24,
      "showControls": true,
      "showOnCapturedMonitor": true
    }
  },
  "lockscreen": {
    "blurWallpaper": true,
    "showClock": true,
    "showDate": true,
    "showUsername": true,
    "showWeather": false,
    "showBattery": true,
    "showNetwork": false,
    "showPower": true,
    "showMedia": true,
    "mediaShowPaused": true,
    "mediaShowArt": false
  },
  "powerMenu": {
    "confirmActions": true,
    "actions": [
      "lock",
      "suspend",
      "reboot",
      "shutdown",
      "logout"
    ]
  },
  "gamingMode": {
    "disableAnimations": true,
    "disableWeather": true,
    "disableWallpaperChange": true,
    "hyprland": {
      "disableAnimations": true,
      "disableBlur": true,
      "disableShadows": true,
      "gaps": 0,
      "rounding": 0
    }
  },
  "wallpaper": {
    "primaryMonitor": "",
    "defaultWallpaper": "",
    "postSetScript": "",
    "sources": [],
    "cache": {
      "maxBytes": 524288000
    },
    "monitors": {}
  },
  "services": {
    "weather": {
      "enabled": true,
      "location": "London",
      "latitude": 51.5,
      "longitude": -0.12,
      "units": "metric",
      "refreshMinutes": 15
    },
    "calendar": {
      "reminders": {
        "enabled": true,
        "minutesBefore": 15,
        "lookaheadDays": 2,
        "allDayTime": "09:00"
      },
      "dayView": {
        "hourHeight": 60
      },
      "firstDayOfWeek": 1
    },
    "vpn": {
      "enabled": false,
      "name": ""
    },
    "nightLight": {
      "temperature": 4500
    }
  },
  "connections": {
    "width": 420,
    "maxHeight": 640
  },
  "audio": {
    "width": 420,
    "maxHeight": 640
  },
  "storage": {
    "warningFreePercent": 10,
    "criticalFreePercent": 5,
    "excludedMounts": [
      "/boot",
      "/boot/efi",
      "/efi"
    ],
    "order": [
      "/",
      "/home"
    ],
    "labels": {}
  },
  "temporaryModes": {
    "durationsMinutes": [
      15,
      30,
      60,
      120
    ]
  }
}
